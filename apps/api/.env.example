# Transaction-mode pooler (runtime API queries)
# If the password has ?, @, #, %, or &, URL-encode it (e.g. ? → %3F)
DATABASE_URL="postgresql://postgres.nwxshrpsunitweeoiuvy:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler (migrations, db push, seed)
DIRECT_URL="postgresql://postgres.nwxshrpsunitweeoiuvy:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Local Docker fallback (optional)
# DATABASE_URL="postgresql://agencyflow:agencyflow@localhost:5433/agencyflow?schema=public"

JWT_SECRET="change-me-in-production"
PORT=3001
WEB_ORIGIN="http://localhost:3000"

# Supabase API (REST / Auth / future client SDK)
SUPABASE_URL="https://nwxshrpsunitweeoiuvy.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
# Razorpay (test keys from dashboard.razorpay.com → API Keys)
