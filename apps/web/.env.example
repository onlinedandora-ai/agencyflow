# Same-origin Next.js API (no Render / Nest required)
NEXT_PUBLIC_API_URL=

# Database (Google Cloud SQL PostgreSQL / Prisma)
# For Cloud SQL: postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE (via Cloud SQL Proxy)
# Or Direct: postgresql://USER:PASSWORD@IP:5432/DATABASE?sslmode=require
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=

# Optional payments + cron
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CRON_SECRET=

# Google / Firebase Auth
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

