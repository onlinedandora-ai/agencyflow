{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm install --include=optional",
  "buildCommand": "cd ../.. && npm run build --workspace=apps/web",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/automations?job=lead_sla_scan",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/automations?job=proposal_followup",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/automations?job=invoice_overdue",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/automations?job=deliverable_review_nudge",
      "schedule": "*/15 * * * *"
    }
  ]
}
